import float_hex
import mhd_kernel
step_loop state n = if n <= 0 then state else step_loop (mk_lxf_step state (mk_compute_dt state)) (n - 1)
digest raw =
  let s = mk_init_state
  let _ = mk_perturb_seed s raw
  let f = step_loop s 8
  mk_max_div_b f
main =
  -- Known-answer: seed 246384 is a real beacon epoch (2026-08-30 log); replaying the seed
  -- two frames must reproduce one max|div B| exactly. The judge is the double's 64 bits (Rail
  -- stdlib/float_hex.rail, derived by exact arithmetic, the same on every IEEE-754 platform),
  -- not snprintf's 13 digits: that text accepted a value two ulps away, and the Linux libc's
  -- float printer printed the old digest as "0".
  --   5.655198531684391e-15 = 0x3cf9780000000000 = 815 * 2^-57, measured 2026-10-21 on the
  --   kernel whose sin is stdlib/math_exact.rail (Tier 3, step 4). The libm kernel before it
  --   gave 0x3cf6e80000000000 = 5864 * 2^-60, the 5.086209231564e-15 that beacon log printed.
  let a = digest 246384
  let b = digest 987654
  let ha = show_float_hex a
  let hit = ha == "3cf9780000000000"
  let distinct = ha == show_float_hex b
  let _ = print (if hit then (if distinct then "FAIL seeds collide" else "ok") else cat ["FAIL got ", ha, " (", show_float_exact a, ")"])
  0
