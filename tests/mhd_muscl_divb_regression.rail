import mhd_kernel
absf x = if x < 0.0 then 0.0 - x else x
mu state n = if n <= 0 then state else mu (mk_muscl_step state (mk_compute_dt_muscl state)) (n - 1)
main =
  let s0 = mk_init_state
  let m0 = mk_total_mass s0
  let e0 = mk_total_energy s0
  let b = mu mk_init_state 3
  let dm = absf ((mk_total_mass b - m0) / m0)
  let de = absf ((mk_total_energy b - e0) / e0)
  let db = mk_max_div_b b
  let rmin = mk_min_density b
  let cons_ok = if dm < 0.0000000001 then (if de < 0.0000000001 then (if rmin > 0.0 then 1 else 0) else 0) else 0
  let divb_dirty = if db > 0.000000001 then (if db < 0.01 then 1 else 0) else 0
  let _ = print (if cons_ok == 1 then (if divb_dirty == 1 then "ok" else "FAIL") else "FAIL")
  0
